{
  "name": "react-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:debug": "NODE_OPTIONS='--inspect=0.0.0.0:9230' react-router dev",
    "dev:debug-verbose": "DEBUG=vite:* NODE_OPTIONS='--inspect=0.0.0.0:9230' react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "clean": "npm cache clean --force && rm -rf node_modules && rm -rf dist",
    "rebuild": "npm install && npm run build",
    "build:fresh": "npm run clean && npm run rebuild",
    "seed": "node supabase/seed.js"
  },
  "dependencies": {
    "@mantine/core": "^8.2.7",
    "@mantine/dates": "^8.2.7",
    "@mantine/form": "^7.16.2",
    "@mantine/hooks": "^8.2.7",
    "@react-router/fs-routes": "^7.4.1",
    "@react-router/node": "*",
    "@react-router/serve": "*",
    "@stripe/react-stripe-js": "^3.5.1",
    "@stripe/stripe-js": "^6.1.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.75.0",
    "@turf/bbox": "^7.3.1",
    "@use-gesture/react": "^10.3.1",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.4.9",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "css-loader": "^7.1.2",
    "dayjs": "^1.11.15",
    "dotenv": "^16.4.5",
    "framer-motion": "^11.0.0",
    "isbot": "^5.1.17",
    "lucide-react": "^0.487.0",
    "maplibre-gl": "^5.15.0",
    "marked": "^15.0.8",
    "nodemailer": "^6.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.1.0",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.0.18",
    "react-router": "*",
    "react-router-dom": "^7.4.1",
    "stripe": "^14.25.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@react-router/dev": "*",
    "@tailwindcss/vite": "^4.0.0",
    "dotenv-cli": "^7.4.2",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
    "postcss-preset-mantine": "^1.17.0",
